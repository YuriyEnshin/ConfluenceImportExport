<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <!--
      xUnit1051 ("pass TestContext.Current.CancellationToken to methods that
      accept a CancellationToken") is error-by-default in xunit.v3. Now that
      the service/API/MCP surface accepts CancellationToken (PR-A), the rule
      fires on every existing call site. Our unit tests use mocked HTTP and
      in-memory filesystem fixtures, so test-runner cancellation responsiveness
      is not a concern here; suppress the rule rather than thread the runner
      token through every call. Cancellation behaviour itself is covered by
      dedicated tests that pass an explicit (cancelled) token.

      TODO: remove this suppression and instead pass
      TestContext.Current.CancellationToken at the test call sites, so the rule
      stays enforced for new tests. Deferred to keep the A+B diff focused.
    -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" Version="8.10.0" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="2.2.3" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="xunit.v3.mtp-v2" Version="3.2.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ConfluencePageExporter\ConfluencePageExporter.csproj" />
  </ItemGroup>

</Project>
